# ─────────────────────────────────────────────────────────────────
#  Notes AI — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────
#
#  LOCAL DEV:
#    1. Copy this file:  cp .env.example .env.local
#    2. Set the URL to your local backend (default FastAPI port):
#       NEXT_PUBLIC_API_URL=http://localhost:8000
#
#  VERCEL DEPLOYMENT:
#    Do NOT commit .env to git. Instead add this variable in:
#    Vercel Dashboard → Your Project → Settings → Environment Variables
#
#    Set it to your Render backend URL, e.g.:
#       NEXT_PUBLIC_API_URL=https://notes-ai-1-8dd0.onrender.com
#
#    ⚠️  The variable MUST start with NEXT_PUBLIC_ so Next.js
#        exposes it to the browser bundle.
# ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com
